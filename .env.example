# TESTING BRANCH ONLY. Never copy a production .env into this checkout.
# Create a separate database named moodora_testing and a dedicated database user.
TESTING_DATABASE_URL="postgresql://TESTING_USER:CHANGE_ME@127.0.0.1:55440/moodora_testing?schema=public"
# TESTING_DIRECT_DATABASE_URL="postgresql://TESTING_USER:CHANGE_ME@TEST_DB_HOST/moodora_testing?sslmode=require"
TESTING_AUTH_SECRET="generate-a-new-random-secret-at-least-32-characters"
# Local: http://localhost:3100. Hosted: the separate test deployment's origin.
# testing.trfyx.com may be used only with its DNS owner's permission.
TESTING_AUTH_URL="http://localhost:3100"
# Optional separate OAuth app with a testing callback. Set both or neither.
# TESTING_AUTH_GOOGLE_ID=""
# TESTING_AUTH_GOOGLE_SECRET=""
# Optional isolated Stripe SANDBOX, never the production website's sandbox/account.
# TESTING_STRIPE_SECRET_KEY="sk_test_..."
# TESTING_STRIPE_WEBHOOK_SECRET="whsec_..."
# TESTING_STRIPE_MONTHLY_PRICE_ID="price_..." # recurring USD 15 / month
# TESTING_STRIPE_YEARLY_PRICE_ID="price_..." # recurring USD 150 / year
# TESTING_STRIPE_PORTAL_CONFIGURATION_ID="bpc_..."
# Optional separate TRFYX test website. Blank means analytics is disabled.
# Never use Moodora's live website ID wwfhn43v8pg5.
NEXT_PUBLIC_TESTING_TRFYX_WEBSITE_ID=""
NEXT_PUBLIC_TESTING_TRFYX_DOMAIN="testing.trfyx.com"
