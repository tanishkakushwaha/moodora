DATABASE_URL="postgresql://bloom:CHANGE_ME@localhost:55439/bloom?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Optional Google OAuth. Callback: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# On Vercel, use hosted PostgreSQL, not your laptop's localhost URL.
# Neon through Vercel Storage supplies DATABASE_URL and DATABASE_URL_UNPOOLED.
# Optional direct migration connection, preferred over DATABASE_URL_UNPOOLED:
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"
# AUTH_URL may be omitted on Vercel to use its detected HTTPS domains.
